# Copie para .env e ajuste
DATABASE_URL=postgres://storyteller_app:troque-esta-senha@db:5432/storyteller
POSTGRES_PASSWORD=troque-esta-senha
BIND_ADDR=0.0.0.0:8080
DATA_DIR=/data
RUST_LOG=storyteller=info,tower_http=info
APP_PORT=8090
# Cookie só por HTTPS (true em produção)
COOKIE_SEGURO=false
# Admin criado na primeira execução (só se o banco não tiver nenhum usuário)
ADMIN_EMAIL=
ADMIN_SENHA=
ADMIN_NOME=Admin
ADMIN_FAMILIA=Família Silva
# Dono da pasta de dados no host (id -u / id -g)
APP_UID=1000
APP_GID=1000
# IP em que a porta fica aberta (0.0.0.0 = acessível pela rede/VPN)
APP_BIND_IP=127.0.0.1
# Chave-mestra para criptografar as chaves de API (base64 de 32 bytes). Gere com: openssl rand -base64 32
CHAVE_MESTRA=
# Endereço público (para montar links de convite)
URL_PUBLICA=http://localhost:8090
# IA por API (modelos opcionais; padrões no código)
ANTHROPIC_MODELO=claude-opus-5-5
GEMINI_MODELO=gemini-2.5-flash
OPENAI_MODELO=gpt-4.1-mini
# Chave gratuita do Gemini (free tier) para famílias sem nenhuma outra IA de texto
GEMINI_CHAVE_GRATIS=
# CLI para texto: claude (padrão) ou agy
CLI_TEXTO=claude
# E-mail (Gmail com senha de app: https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_USUARIO=
SMTP_SENHA=
SMTP_REMETENTE=
