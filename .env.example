# Desenvolvimento local. Copie para .env.
# Quase tudo (IA, e-mail, endereço público, admin) se configura pelo site: /instalar e ⚙️ Sistema.

# Banco (o compose de desenvolvimento sobe um Postgres próprio)
POSTGRES_PASSWORD=troque-esta-senha
DATABASE_URL=postgres://storyteller_app:troque-esta-senha@db:5432/storyteller

# Porta no PC e em qual IP ela abre (0.0.0.0 = acessível pela rede)
APP_PORT=8090
APP_BIND_IP=127.0.0.1

# Cookie só por HTTPS (true em produção)
COOKIE_SEGURO=false

# Dono da pasta de dados (id -u / id -g)
APP_UID=1000
APP_GID=1000

RUST_LOG=storyteller=info,tower_http=info

# ── Opcionais (o que for salvo no site tem prioridade) ──
# CHAVE_MESTRA=          # sem ela, o app cria uma em DATA_DIR/segredos/chave-mestra
# ADMIN_EMAIL= / ADMIN_SENHA= / ADMIN_NOME= / ADMIN_FAMILIA=   # alternativa ao /instalar
# URL_PUBLICA=http://localhost:8090
# CLAUDE_CODE_OAUTH_TOKEN=
# GEMINI_CHAVE_GRATIS=
