# Produção (VPS Oracle) — o mínimo. Todo o resto se configura no site (⚙️ Sistema).
# O banco vem do .env.db (já existe na VPS).
COOKIE_SEGURO=true
DATA_HOST_DIR=/opt/docker/volumes/storyteller_data
APP_UID=1000
APP_GID=1000
RUST_LOG=storyteller=info,tower_http=warn
# Opcional: CHAVE_MESTRA. Sem ela, o app cria uma em DATA_DIR/segredos/chave-mestra
# (fica junto das mídias; o backup da pasta de dados precisa incluí-la).
